# Plantilla de Nginx para producción. La imagen oficial de Nginx la convierte
# en /etc/nginx/conf.d/default.conf al arrancar y reemplaza ${PORT} por la
# variable de entorno (Railway la define; la imagen trae 80 por defecto). Las
# variables propias de Nginx ($uri, etc.) no se tocan.
server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Comprime lo que pesa: JS, CSS, JSON y SVG.
    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # La app usa React Router: cualquier ruta que no sea un archivo devuelve
    # index.html para que el enrutamiento lo haga el navegador. index.html no
    # se cachea, así cada despliegue se ve de inmediato.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # Los archivos de assets llevan hash en el nombre; se pueden cachear un año.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options nosniff always;
    }
}
