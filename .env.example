# Copiar como .env en la raíz del proyecto (docker-compose lo lee solo).
# Todos los valores de este archivo sirven tal cual para desarrollo local.

# --- Puertos publicados en tu máquina ---
FRONTEND_PORT=5173
APP_PORT=8000
POSTGRES_PORT=5432

# --- Base de datos (contenedor db) ---
POSTGRES_DB=tutorias_ecci
POSTGRES_USER=tutorias_user
POSTGRES_PASSWORD=change_me_secure_password

# --- Backend (Django) ---
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
# 1 = carga los datos de prueba al arrancar (solo si no existen). 0 = no los carga.
SEED_DEMO=1

# --- Frontend ---
# Dominios de correo aceptados en el login. aulalibre.test es el de los datos de prueba.
VITE_EMAIL_DOMAINS=ecci.edu.co,aulalibre.test
# true en Windows/Mac para que Vite detecte cambios dentro de Docker.
VITE_USE_POLLING=true

# --- Correo del sistema (recuperación de contraseña) ---
# Pedir los valores al Scrum Master; no subirlos al repositorio.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
